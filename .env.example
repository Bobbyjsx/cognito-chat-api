# API Runtime Configuration
APP_NAME=Cognito Chat API
ENVIRONMENT=production
PORT=8002
DEBUG=false

# AI Model Keys & Providers
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Claude / AWS Bedrock (if used)
AWS_BEDROCK_API_KEY=
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Google Cloud & Firebase Firestore Configuration
GCP_PROJECT_ID=project-atlas-501612
GOOGLE_CLOUD_PROJECT=project-atlas-501612
FIRESTORE_DATABASE=cognito-prod-db
FIREBASE_CREDENTIALS_JSON=
GCP_SERVICE_KEY=
FIREBASE_CREDENTIALS_PATH=firebase-credentials.json

# Object Storage (attachments)
STORAGE_BACKEND=local
STORAGE_BUCKET=cognito-chat-attachments
LOCAL_STORAGE_DIR=/app/storage_data

# Auth & Cryptography Settings
SECRET_KEY=supersecretkey_please_change_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Centralized Identity Service Settings
IDENTITY_SERVICE_URL=https://vm-id.bobslab.xyz
IDENTITY_ISSUER=https://vm-id.bobslab.xyz
IDENTITY_JWKS_URL=https://vm-id.bobslab.xyz/.well-known/jwks.json
IDENTITY_AUDIENCE=application_api

# Redis In-Memory Cache
REDIS_URL=

# Background Generation Workers ("local" or "cloudtasks")
WORKER_PROVIDER=local
CLOUD_TASKS_PROJECT=
CLOUD_TASKS_LOCATION=us-central1
CLOUD_TASKS_QUEUE=cognito-generations
CLOUD_TASKS_WORKER_URL=
CLOUD_TASKS_SERVICE_ACCOUNT_EMAIL=

# Paystack Billing & Subscriptions
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_SECRET=
PAYSTACK_BASE_URL=https://api.paystack.co
GO_PAYSTACK_PLAN_CODE=
PREMIUM_PAYSTACK_PLAN_CODE=
