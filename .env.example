# API Configuration
APP_NAME="Antigravity AI API"
DEBUG=False

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Database Configuration (Firebase)
FIREBASE_CREDENTIALS_PATH=firebase-credentials.json

# Object Storage (attachments)
# STORAGE_BACKEND=gcs (or leave empty with STORAGE_BUCKET set → auto gcs)
# STORAGE_BACKEND=local for local development
STORAGE_BACKEND=
STORAGE_BUCKET=cognito-chat-attachments
LOCAL_STORAGE_DIR=./storage_data

# Auth Settings
SECRET_KEY=supersecretkey_please_change_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
FIRESTORE_DATABASE="agy-sdk"

# Identity Service / Resource Server Settings
IDENTITY_SERVICE_URL=http://localhost:8002
IDENTITY_ISSUER=http://localhost:8002
IDENTITY_JWKS_URL=
IDENTITY_AUDIENCE=application_api


UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
REDIS_URL=

# Background Worker Provider ("local" or "cloudtasks")
WORKER_PROVIDER=local

# Cloud Tasks (Background Generations - required if WORKER_PROVIDER=cloudtasks)
CLOUD_TASKS_PROJECT=
CLOUD_TASKS_LOCATION="us-central1"
CLOUD_TASKS_QUEUE="cognito-generations"
CLOUD_TASKS_WORKER_URL=
CLOUD_TASKS_SERVICE_ACCOUNT_EMAIL=
